# Example environment variables for Sapphire Charting API
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sapphire
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin123

# ============================================
# Keycloak Configuration
# ============================================
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:8090/realms/saphhire-ui/protocol/openid-connect/certs
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8090/realms/saphhire-ui

# ============================================
# OpenTelemetry Configuration
# ============================================
OTEL_VERSION=1.32.0
OTEL_SERVICE_NAME=sapphire-charting-api
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=service.name=sapphire-charting-api,service.version=1.0.0,deployment.environment=production

# ============================================
# JVM Configuration
# ============================================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs

# ============================================
# Spring Profile
# ============================================
SPRING_PROFILES_ACTIVE=prod

# ============================================
# Application Configuration
# ============================================
SERVER_PORT=8089

# ============================================
# Security Configuration
# ============================================
APP_SECURITY_REQUIRED_SCOPES=email,profile

# Made with Bob